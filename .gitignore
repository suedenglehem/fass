.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
battery-out/
docker-data/
# machine-local volume paths (docker/install.sh writes these)
docker/.env
media/input/
media/output/
media/log/

# RAG corpus data — rebuilt by rag/tools/build_corpus.sh
# (recipe recorded in rag/corpus/BUILD-RECIPE.md)
rag/corpus/*/docs/
rag/corpus/*/_build/
rag/corpus/*/chunks/
rag/corpus/*/build-facts/*
!rag/corpus/*/build-facts/manifest.json

# benchmark run output (regenerated by rag/benchmark/run_benchmark.py)
rag/benchmark/results.json
